{
  "id": "provision",
  "version": "0.1.0",
  "description": "Headless provision service; no Web or graphical host required.",
  "metadata": {
    "ui": {
      "id": "dev.delta.provision",
      "name": "Delta Provision",
      "version": "0.1.0",
      "contract": "^1.5.0",
      "description": "Headless provision service; no Web or graphical host required.",
      "publisher": "Delta",
      "icon": "server",
      "category": "system",
      "runtime": {
        "targets": [
          "desktop",
          "vps",
          "container"
        ]
      },
      "capabilities": [
        "actions"
      ],
      "metrics": [],
      "repository": "https://github.com/n-ycta/delta-provision",
      "permissions": [
        {
          "scope": "admin",
          "reason": "Trusted executable service; OS sandboxing is not provided.",
          "optional": false
        }
      ],
      "dependencies": [
        {
          "kind": "core",
          "version": ">=0.4.3, <0.5.0",
          "required": true,
          "id": "core"
        }
      ]
    }
  },
  "capabilities": [
    {
      "name": "probe",
      "params": {},
      "admin": true,
      "description": "Provision API: probe"
    },
    {
      "name": "install",
      "params": {},
      "admin": true,
      "description": "Provision API: install"
    },
    {
      "name": "status",
      "params": {},
      "admin": true,
      "description": "Provision API: status"
    },
    {
      "name": "preflight",
      "params": {},
      "admin": true,
      "description": "Provision API: preflight"
    },
    {
      "name": "connections",
      "admin": true,
      "params": {}
    },
    {
      "name": "remove",
      "admin": true,
      "params": {}
    }
  ]
}
